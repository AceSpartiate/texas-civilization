<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The teacher's launcher.

    It is deliberately a face and not a second implementation. Starting and stopping the
    classroom server is delicate - the stop has to authenticate with the private Host
    credential, ask the class to checkpoint and pause, and then wait, because forcing the
    process leaves a stale save lock that costs a teacher their class. That sequence is
    already written once in scripts/launch.ps1 and scripts/stop.ps1 and is held by eight
    PASS lines in scripts/verify-launcher.ps1. This app drives those scripts. A second
    copy of that protocol in C# would be a second thing to get wrong.

    WebView2 rather than a bundled browser: Windows 11 already has the runtime, so the
    presentation window costs a few megabytes instead of a hundred and fifty.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TexasRevolution.Launcher</RootNamespace>
    <AssemblyName>TexasRevolution</AssemblyName>
    <Product>Texas Revolution</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      One binary does two jobs, and the two jobs want different icons.

      The file a teacher downloads is a setup program, and in a Downloads folder it should
      look like one - so the icon compiled into the executable is the emblem opened as a
      box. The installed program is not a setup program and keeps the plain emblem, which
      it gets from the embedded copy below: every window title bar reads it at runtime,
      and the Start menu entry, the desktop shortcut and the Add/Remove listing are all
      pointed at a copy of it written beside the installed executable.

      Both are built from the owner's own artwork; see docs/art-provenance.json.

      The one place the two diverge visibly is the installed .exe seen in Explorer, which
      keeps the setup icon because a single-file bundle cannot have its icon resource
      rewritten after publishing without breaking the bundle. Nobody opens that folder in
      ordinary use; everything a teacher actually clicks carries the plain emblem.
    -->
    <ApplicationIcon>TexasRevolutionSetup.ico</ApplicationIcon>
    <!-- A teacher drags this window from a laptop panel onto a projector with a different
         scale factor, and a blurry class view is the whole lesson. WinForms wants this as a
         project property rather than in the manifest. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>

  <!-- The installed program's own emblem, read at runtime by Branding. -->
  <ItemGroup>
    <EmbeddedResource Include="TexasRevolution.ico" LogicalName="TexasRevolution.Launcher.emblem.ico" />
  </ItemGroup>

  <!--
    The launcher's face: the owner's title painting and the eight cast button plates, supplied
    2026-09-20 (art/background.png, art/button-*.png).

    Embedded rather than copied beside the executable, for three reasons. The installed program
    is a single self-contained file and an art folder next to it is one more thing an update
    swap, an antivirus quarantine or a helpful teacher can lose. Nothing else reads these files,
    so there is no reason for them to be on disk. And a resource inside the assembly cannot be
    half-written: it is either there or the launcher falls back to plain colour, which is what
    TitleScene and PlateButton are written to do.

    The cost is honest and worth saying: about 15 MB on top of the ~60 MB self-contained
    download. scripts/package.ps1 publishes this project, so it carries them with no change
    there; a working copy's `dotnet build` carries them too, which is how they are looked at.
  -->
  <ItemGroup>
    <EmbeddedResource Include="art\*.png" LogicalName="TexasRevolution.Launcher.art.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The game, carried inside the setup file.

    It is built by scripts/package.ps1 just before this project is published, and it holds
    the game only - never this launcher. Embedding the launcher inside the launcher would
    put .NET in the download twice; instead the setup copies itself into place. Without the
    payload this still builds, and the result is the plain launcher for a working copy.
  -->
  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="TexasRevolution.Launcher.payload.zip" />
  </ItemGroup>

</Project>
