node_modules/
data/
runtime/
test-results/
output/
*.log

# Scratch probes left by development sessions.
*.tmp.mjs

# Preflight records describe this particular machine - hostname, adapters, firewall
# state, local paths. They are real evidence and they stay on the machine that made them.
docs/evidence/preflight-*.json

# Launcher build output.
launcher/bin/
launcher/obj/
scripts/solo-dialog-shot/bin/
scripts/solo-dialog-shot/obj/

launcher/payload.zip
launcher/payload-launcher.exe
tests/launcher/bin/
tests/launcher/obj/

# The WebP copies of the art, made from the PNG masters by `npm run build:webp` (scripts/build-webp.mjs, triage D14) and
# shipped by scripts/package.ps1. Made, not kept: the PNGs are the art.
public/assets/webp/

# The read-aloud sentences spoken at package time (scripts/build-voice.mjs, docs/READ_ALOUD.md), shipped by
# scripts/package.ps1. Made, not kept: the game's own text is the source of them.
public/voice/

# Read Aloud keeps every sentence it has spoken here.
read-aloud/cache/
# ...and node scripts/package-read-aloud.mjs builds its zip here (with the voices, hundreds of megabytes).
dist/read-aloud/
